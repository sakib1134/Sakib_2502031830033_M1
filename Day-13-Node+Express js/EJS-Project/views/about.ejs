<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> </title>
</head>
<body>
    <h1><%= title %></h1>
    

    <table border="1" width="200px">
        <% items.forEach(item => {  %> 
        <tr>
            <td><%= items.name  %>   </td>
            <td><%= items.age  %>   </td>
            <td><%= items.city %>   </td>
        </tr>
        <% }) %> 
    </table>
</body>
</html>